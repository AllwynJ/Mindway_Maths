    { "id": "ssc-percentage-001", "exam": "ssc", "subject": "aptitude", "topic": "percentage", "difficulty": "Easy", "type": "MCQ", "questionText": "What is 25% of 240?", "options": ["40", "50", "60", "80"], "correctOption": 2, "explanation": "25% means one quarter. Divide 240 by 4 to get 60.", "shortcut": "25% = 1/4; 12.5% = 1/8.", "source": "Mindway original sample", "isActive": true },
    { "id": "ssc-percentage-002", "exam": "ssc", "subject": "aptitude", "topic": "percentage", "difficulty": "Medium", "type": "MCQ", "questionText": "A price increases by 20% and then decreases by 20%. What is the net change?", "options": ["No change", "4% decrease", "4% increase", "2% decrease"], "correctOption": 1, "explanation": "Start at 100. After a 20% increase it is 120. A 20% decrease on 120 gives 96, a net decrease of 4%.", "shortcut": "Equal successive increase and decrease of x% gives a net loss of x²/100%.", "source": "Mindway original sample", "isActive": true },
    { "id": "ssc-percentage-003", "exam": "ssc", "subject": "aptitude", "topic": "percentage", "difficulty": "Easy", "type": "NUMERICAL", "questionText": "Find 15% of 360.", "numericalAnswer": 54, "tolerance": 0.001, "explanation": "10% is 36 and 5% is 18. Their sum is 54.", "source": "Mindway original sample", "isActive": true },
    { "id": "ssc-percentage-004", "exam": "ssc", "subject": "aptitude", "topic": "percentage", "difficulty": "Medium", "type": "MCQ", "questionText": "A student scores 144 marks out of 180. What is the percentage?", "options": ["70%", "75%", "80%", "85%"], "correctOption": 2, "explanation": "Percentage = (144 ÷ 180) × 100 = 80%.", "source": "Mindway original sample", "isActive": true },
    { "id": "ssc-profit-001", "exam": "ssc", "subject": "aptitude", "topic": "profit-loss", "difficulty": "Easy", "type": "MCQ", "questionText": "An item costs ₹500 and sells for ₹600. Find the profit percentage.", "options": ["10%", "16.67%", "20%", "25%"], "correctOption": 2, "explanation": "Profit is ₹100. Profit percentage = 100/500 × 100 = 20%. Always use cost price as the base.", "source": "Mindway original sample", "isActive": true },
    { "id": "ssc-average-001", "exam": "ssc", "subject": "aptitude", "topic": "average", "difficulty": "Easy", "type": "MCQ", "questionText": "Find the average of 12, 18, 24 and 30.", "options": ["18", "20", "21", "24"], "correctOption": 2, "explanation": "The sum is 84. Divide by 4 to get 21.", "source": "Mindway original sample", "isActive": true },
    { "id": "ssc-work-001", "exam": "ssc", "subject": "aptitude", "topic": "time-work", "difficulty": "Medium", "type": "MCQ", "questionText": "A completes a task in 12 days and B in 6 days. Working together, how long do they take?", "options": ["3 days", "4 days", "6 days", "9 days"], "correctOption": 1, "explanation": "Their combined daily work is 1/12 + 1/6 = 1/4. They finish in 4 days.", "source": "Mindway original sample", "isActive": true },
    { "id": "ssc-interest-001", "exam": "ssc", "subject": "aptitude", "topic": "simple-interest", "difficulty": "Easy", "type": "NUMERICAL", "questionText": "Find the simple interest in rupees on ₹2,000 at 5% per year for 3 years.", "numericalAnswer": 300, "explanation": "SI = PRT/100 = 2000 × 5 × 3 / 100 = ₹300.", "source": "Mindway original sample", "isActive": true },
    { "id": "ssc-series-001", "exam": "ssc", "subject": "reasoning", "topic": "series", "difficulty": "Easy", "type": "MCQ", "questionText": "Find the next number: 3, 6, 12, 24, ?", "options": ["30", "36", "42", "48"], "correctOption": 3, "explanation": "Each number is double the previous number. 24 × 2 = 48.", "source": "Mindway original sample", "isActive": true },
    { "id": "ssc-series-002", "exam": "ssc", "subject": "reasoning", "topic": "series", "difficulty": "Medium", "type": "MCQ", "questionText": "Find the next number: 2, 5, 10, 17, 26, ?", "options": ["35", "36", "37", "39"], "correctOption": 2, "explanation": "Differences are 3, 5, 7, 9. Add the next odd number, 11, to 26 to get 37.", "source": "Mindway original sample", "isActive": true },
    { "id": "ssc-coding-001", "exam": "ssc", "subject": "reasoning", "topic": "coding-decoding", "difficulty": "Easy", "type": "MCQ", "questionText": "If CAT is coded as DBU by shifting each letter one step forward, how is DOG coded?", "options": ["EPH", "CNE", "EPG", "FQI"], "correctOption": 0, "explanation": "D→E, O→P, G→H. DOG becomes EPH.", "source": "Mindway original sample", "isActive": true },
    { "id": "ssc-direction-001", "exam": "ssc", "subject": "reasoning", "topic": "direction-sense", "difficulty": "Easy", "type": "MCQ", "questionText": "A person faces north, turns right, and then turns right again. Which direction are they facing?", "options": ["North", "South", "East", "West"], "correctOption": 1, "explanation": "The first right turn faces east. The second right turn faces south.", "source": "Mindway original sample", "isActive": true },
    { "id": "ssc-syllogism-001", "exam": "ssc", "subject": "reasoning", "topic": "syllogism", "difficulty": "Medium", "type": "TRUE_FALSE", "questionText": "All squares are rectangles. All rectangles are polygons. Therefore, all squares are polygons.", "options": ["True", "False"], "correctOption": 0, "explanation": "The first set is contained in the second, which is contained in the third. Hence all squares are polygons.", "source": "Mindway original sample", "isActive": true },
    { "id": "ssc-ranking-001", "exam": "ssc", "subject": "reasoning", "topic": "ranking", "difficulty": "Easy", "type": "MCQ", "questionText": "Ravi is 7th from the top and 9th from the bottom in a class ranking. How many students are there?", "options": ["14", "15", "16", "17"], "correctOption": 1, "explanation": "Total = rank from top + rank from bottom − 1 = 7 + 9 − 1 = 15.", "source": "Mindway original sample", "isActive": true }
