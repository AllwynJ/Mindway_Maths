rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function writable(uid) {
      return owner(uid) && exists(/databases/$(database)/documents/users/$(uid)) &&
        !get(/databases/$(database)/documents/users/$(uid)).data.get('deletionPending', false);
    }
    function boundedList() { return request.query.limit != null && request.query.limit <= 1000; }
    function profileFields() {
      return ['uid','displayName','email','photoUrl','createdAt','lastLoginAt','selectedExam','selectedLanguage','dailyGoal',
        'totalQuestionsSolved','totalCorrect','totalTests','streak','appVersion','deletionPending'];
    }
    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(profileFields()) && d.keys().hasAll(['uid','dailyGoal','selectedLanguage']) &&
        d.uid == request.auth.uid && d.dailyGoal is int && d.dailyGoal >= 5 && d.dailyGoal <= 200 &&
        d.selectedLanguage is string && d.selectedLanguage.size() <= 10 &&
        (!('displayName' in d) || (d.displayName is string && d.displayName.size() <= 200)) &&
        (!('email' in d) || (d.email is string && d.email.size() <= 320)) &&
        (!('selectedExam' in d) || (d.selectedExam is string && d.selectedExam.size() <= 100));
    }
    match /users/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      allow create: if owner(uid) && validProfile();
      allow update: if owner(uid) && validProfile() &&
        (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
        (!(resource.data.get('deletionPending', false)) || request.resource.data.deletionPending == true);
      allow delete: if owner(uid);
      match /attempts/{attemptId} {
        allow get: if owner(uid);
        allow list: if owner(uid) && boundedList();
        allow create: if writable(uid) && request.resource.data.keys().hasOnly(['id','uid','questionId','topic','selectedOption','numericalAnswer','correct','timeTaken','attemptNumber','timestamp','receivedAt']) &&
          request.resource.data.uid == uid && request.resource.data.id == attemptId && request.resource.data.questionId is string &&
          request.resource.data.questionId.size() <= 100 && request.resource.data.correct is bool &&
          request.resource.data.timeTaken is int && request.resource.data.timeTaken >= 0 && request.resource.data.timeTaken <= 10800000 &&
          request.resource.data.attemptNumber is int && request.resource.data.attemptNumber >= 1 && request.resource.data.timestamp is int && request.resource.data.receivedAt == request.time;
        allow update: if writable(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receivedAt']) && request.resource.data.receivedAt == request.time;
        allow delete: if owner(uid);
      }
      match /testHistory/{id} {
        allow get: if owner(uid);
        allow list: if owner(uid) && boundedList();
        allow create: if writable(uid) && request.resource.data.keys().hasOnly(['sessionId','uid','timestamp','total','attempted','correct','incorrect','skipped','score','maxScore','accuracy','percentage','averageMillis','topics','subjects','payload','snapshot','receivedAt']) &&
          request.resource.data.uid == uid && request.resource.data.sessionId == id &&
          request.resource.data.total is int && request.resource.data.total >= 1 && request.resource.data.total <= 100 &&
          request.resource.data.topics is map && request.resource.data.subjects is map && request.resource.data.receivedAt == request.time &&
          request.resource.data.payload is string && request.resource.data.payload.size() < 100000 && request.resource.data.snapshot is string && request.resource.data.snapshot.size() < 800000;
        allow update: if writable(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receivedAt']) && request.resource.data.receivedAt == request.time;
        allow delete: if owner(uid);
      }
      match /bookmarks/{id} {
        allow get: if owner(uid);
        allow list: if owner(uid) && boundedList();
        allow create, update: if writable(uid) && request.resource.data.keys().hasOnly(['questionId','active','updatedAt']) &&
          request.resource.data.questionId == id && request.resource.data.active is bool && request.resource.data.updatedAt is int;
        allow delete: if owner(uid);
      }
      match /mastery/{id} {
        allow get: if owner(uid);
        allow list: if owner(uid) && boundedList();
        allow write: if false;
        allow delete: if owner(uid);
      }
      match /devices/{id} {
        allow get, delete: if owner(uid);
        allow list: if owner(uid) && boundedList();
        allow create, update: if false;
      }
    }
    match /progress/{uid} {
      allow read, delete: if owner(uid);
      allow create, update: if writable(uid) && request.resource.data.keys().hasOnly(['totalQuestionsSolved','totalCorrect','totalTests','streak','updatedAt']) &&
        request.resource.data.totalQuestionsSolved is int && request.resource.data.totalQuestionsSolved >= 0 &&
        request.resource.data.totalCorrect is int && request.resource.data.totalCorrect >= 0 &&
        request.resource.data.totalCorrect <= request.resource.data.totalQuestionsSolved;
    }
    match /settings/{uid} { allow get, delete: if owner(uid); allow write: if false; }
    match /bookmarks/{uid} { allow get, delete: if owner(uid); allow write: if false; }
    match /{collection}/{id} {
      allow get: if signedIn() && collection in ['exams','subjects','topics','questions','tests','testQuestions','videos','pdfs','dailyChallenges'];
      allow list: if signedIn() && boundedList() && collection in ['exams','subjects','topics','questions','tests','testQuestions','videos','pdfs','dailyChallenges'];
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
